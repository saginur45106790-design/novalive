# Copy to .env and set long random secrets; never commit .env
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DBNAME?sslmode=require
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_KEY
LIVEKIT_API_SECRET=YOUR_SECRET
# Node SDK uses HTTPS for RoomService, not wss
LIVEKIT_HTTP_URL=https://YOUR-PROJECT.livekit.cloud
PORT=3000
# Initial super administrator, only for `npm run admin:create`
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=USE_A_NEW_STRONG_PASSWORD
